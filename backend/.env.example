# Copy this file to .env and fill in real keys. Never commit .env.

# Required for chat generation - runs on Ollama Cloud's free tier.
# Get a key at https://ollama.com/settings/keys
OLLAMA_API_KEY=your_ollama_key_here

# Required only to run the eval suite's LLM-judge (backend/eval). Generation
# itself no longer uses Gemini - the judge deliberately stays on a different
# provider/model than generation to avoid self-grading bias.
GEMINI_API_KEY=your_gemini_key_here

# Optional overrides - defaults live in config.py
# GEN_MODEL=gpt-oss:120b
# OLLAMA_HOST=https://ollama.com
# GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
# RAG_TOP_K=10
# RAG_RERANK_K=6
# RAG_RERANK_SCORE_THRESHOLD=-50.0
# RAG_HISTORY_MAX_TURNS=6
# RAG_SESSION_TTL_SECONDS=21600
# ALLOWED_ORIGINS=http://localhost:3000
# GEN_TEMPERATURE=0.4
# GEN_MAX_OUTPUT_TOKENS=2048
# GEN_THINK=low
# GEN_TIMEOUT_SECONDS=60
